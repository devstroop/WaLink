{
  "openapi": "3.0.3",
  "info": {
    "title": "WaLink – WhatsApp HTTP API",
    "version": "0.1.0",
    "description": "Multi-account WhatsApp HTTP API."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "BearerAuth": [] }],
  "components": {
    "securitySchemes": {
      "BearerAuth": { "type": "http", "scheme": "bearer" }
    },
    "parameters": {
      "AccountId": { "name": "account_id", "in": "path", "required": true, "schema": { "type": "string" } },
      "JID": { "name": "jid", "in": "path", "required": true, "schema": { "type": "string" } }
    },
    "schemas": {
      "AccountInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "phone_number": { "type": "string", "nullable": true },
          "account_name": { "type": "string" },
          "authorized": { "type": "boolean" },
          "created_at": { "type": "string" }
        }
      },
      "AccountListResponse": {
        "type": "object",
        "properties": {
          "accounts": { "type": "array", "items": { "$ref": "#/components/schemas/AccountInfo" } },
          "total": { "type": "integer" }
        }
      },
      "CreateAccountRequest": {
        "type": "object",
        "properties": {
          "phone_number": { "type": "string", "example": "919876543210" },
          "account_name": { "type": "string", "example": "My Account" }
        }
      },
      "CreateAccountResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "phone_number": { "type": "string" },
          "account_name": { "type": "string" },
          "created_at": { "type": "string" }
        }
      },
      "UpdateAccountRequest": {
        "type": "object",
        "properties": {
          "account_name": { "type": "string" },
          "phone_number": { "type": "string" }
        }
      },
      "DeleteAccountResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "account_id": { "type": "string" },
          "data_deleted": { "type": "boolean" }
        }
      },
      "SessionStatus": {
        "type": "object",
        "properties": {
          "account_id": { "type": "string" },
          "phone_number": { "type": "string", "nullable": true },
          "authorized": { "type": "boolean" }
        }
      },
      "PhoneLinkResponse": {
        "type": "object",
        "properties": { "linking_code": { "type": "string" } }
      },
      "AccountActionResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "account_id": { "type": "string" }
        }
      },
      "SetProxyRequest": {
        "type": "object",
        "required": ["protocol", "host", "port"],
        "properties": {
          "protocol": { "type": "string", "enum": ["http", "https", "socks5"], "example": "socks5" },
          "host": { "type": "string", "example": "proxy.example.com" },
          "port": { "type": "integer", "example": 1080 },
          "username": { "type": "string" },
          "password": { "type": "string" },
          "enabled": { "type": "boolean", "default": true }
        }
      },
      "ProxyConfigResponse": {
        "type": "object",
        "properties": {
          "protocol": { "type": "string" },
          "host": { "type": "string" },
          "port": { "type": "integer" },
          "username": { "type": "string" },
          "enabled": { "type": "boolean" }
        }
      },
      "SendMessageRequest": {
        "type": "object",
        "properties": {
          "chat": { "type": "string", "example": "919876543210@s.whatsapp.net", "description": "Recipient JID (alternative to phone)" },
          "phone": { "type": "string", "example": "919876543210", "description": "Phone number, digits only (alternative to chat)" },
          "text": { "type": "string", "example": "Hello from WaLink!" },
          "reply_to": { "type": "string", "description": "Message ID to reply to (optional)" }
        }
      },
      "SendMessageResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "message_id": { "type": "string" }
        }
      },
      "ReactionRequest": {
        "type": "object",
        "required": ["chat", "message_id", "emoji"],
        "properties": {
          "chat": { "type": "string" },
          "message_id": { "type": "string" },
          "emoji": { "type": "string", "example": "\ud83d\udc4d" }
        }
      },
      "MarkReadRequest": {
        "type": "object",
        "required": ["chat", "message_ids"],
        "properties": {
          "chat": { "type": "string" },
          "message_ids": { "type": "array", "items": { "type": "string" } }
        }
      },
      "RevokeMessageResponse": {
        "type": "object",
        "properties": {
          "revoked": { "type": "boolean" },
          "timestamp": { "type": "string" }
        }
      },
      "ChatInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "is_group": { "type": "boolean" },
          "pinned": { "type": "boolean" },
          "muted": { "type": "boolean" },
          "archived": { "type": "boolean" }
        }
      },
      "ChatListResponse": {
        "type": "object",
        "properties": {
          "chats": { "type": "array", "items": { "$ref": "#/components/schemas/ChatInfo" } },
          "total": { "type": "integer" }
        }
      },
      "ContactInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "push_name": { "type": "string" },
          "full_name": { "type": "string" },
          "first_name": { "type": "string" },
          "business_name": { "type": "string" },
          "phone": { "type": "string", "nullable": true },
          "picture_url": { "type": "string", "nullable": true }
        }
      },
      "ContactListResponse": {
        "type": "object",
        "properties": {
          "contacts": { "type": "array", "items": { "$ref": "#/components/schemas/ContactInfo" } },
          "total": { "type": "integer" }
        }
      },
      "CheckContactsRequest": {
        "type": "object",
        "required": ["phones"],
        "properties": {
          "phones": { "type": "array", "items": { "type": "string" }, "example": ["919876543210", "14155551234"] }
        }
      },
      "CheckContactResult": {
        "type": "object",
        "properties": {
          "phone": { "type": "string" },
          "on_whatsapp": { "type": "boolean" },
          "jid": { "type": "string" }
        }
      },
      "CheckContactsResponse": {
        "type": "object",
        "properties": {
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/CheckContactResult" } }
        }
      },
      "GroupParticipant": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "nullable": true },
          "is_admin": { "type": "boolean" }
        }
      },
      "GroupInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "nullable": true },
          "created_by": { "type": "string", "nullable": true },
          "participant_count": { "type": "integer" },
          "participants": { "type": "array", "items": { "$ref": "#/components/schemas/GroupParticipant" } },
          "is_announce": { "type": "boolean" },
          "is_locked": { "type": "boolean" },
          "invite_link": { "type": "string", "nullable": true }
        }
      },
      "GroupListResponse": {
        "type": "object",
        "properties": {
          "groups": { "type": "array", "items": { "$ref": "#/components/schemas/GroupInfo" } },
          "total": { "type": "integer" }
        }
      },
      "CreateGroupRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "maxLength": 25 },
          "participants": { "type": "array", "items": { "type": "string" } }
        }
      },
      "UpdateGroupRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "locked": { "type": "boolean" },
          "announce": { "type": "boolean" }
        }
      },
      "GroupParticipantsRequest": {
        "type": "object",
        "required": ["participants", "action"],
        "properties": {
          "participants": { "type": "array", "items": { "type": "string" } },
          "action": { "type": "string", "enum": ["add", "remove", "promote", "demote"] }
        }
      },
      "GroupInviteLinkResponse": {
        "type": "object",
        "properties": { "invite_link": { "type": "string" } }
      },
      "PresenceRequest": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": { "type": "string", "enum": ["composing", "paused", "available", "unavailable"] },
          "chat": { "type": "string", "description": "JID for chat-level typing. Omit for global presence." }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "phone_number": { "type": "string", "nullable": true },
          "push_name": { "type": "string", "nullable": true, "description": "Display name set by the user" },
          "business_name": { "type": "string", "nullable": true, "description": "Business name (if business account)" },
          "verified_name": { "type": "string", "nullable": true, "description": "Verified business name (if verified)" },
          "about": { "type": "string", "nullable": true, "description": "Status / about text" },
          "picture_url": { "type": "string", "nullable": true, "description": "Profile picture URL" },
          "is_business": { "type": "boolean", "description": "True if account is WhatsApp Business" },
          "description": { "type": "string", "nullable": true, "description": "Business description" },
          "address": { "type": "string", "nullable": true, "description": "Business address" },
          "email": { "type": "string", "nullable": true, "description": "Business email" },
          "categories": { "type": "array", "items": { "$ref": "#/components/schemas/ProfileCategory" }, "description": "Business categories" },
          "business_hours": { "$ref": "#/components/schemas/BusinessHoursInfo", "nullable": true },
          "profile_options": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Extra business profile options (cart_enabled, etc.)" }
        }
      },
      "ProfileCategory": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "BusinessHoursInfo": {
        "type": "object",
        "properties": {
          "timezone": { "type": "string", "example": "Asia/Kolkata" },
          "config": { "type": "array", "items": { "$ref": "#/components/schemas/BusinessHoursSlot" } }
        }
      },
      "BusinessHoursSlot": {
        "type": "object",
        "properties": {
          "day_of_week": { "type": "string", "example": "mon" },
          "mode": { "type": "string", "enum": ["open_24h", "specific_hours", "appointment_only"] },
          "open_time": { "type": "string", "example": "09:00" },
          "close_time": { "type": "string", "example": "18:00" }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "about": { "type": "string" }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": { "status": { "type": "string", "example": "ok" } }
      },
      "MessageInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "chat_jid": { "type": "string" },
          "sender_jid": { "type": "string" },
          "from_me": { "type": "boolean" },
          "type": { "type": "string" },
          "body": { "type": "string" },
          "media_type": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "MessageListResponse": {
        "type": "object",
        "properties": {
          "messages": { "type": "array", "items": { "$ref": "#/components/schemas/MessageInfo" } },
          "count": { "type": "integer" }
        }
      },
      "SetWebhookRequest": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "format": "uri", "example": "https://example.com/webhook" },
          "secret": { "type": "string", "description": "HMAC signing secret" },
          "events": { "type": "array", "items": { "type": "string" }, "description": "Event types to subscribe to (empty = all)" },
          "enabled": { "type": "boolean", "default": true }
        }
      },
      "WebhookConfigResponse": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "events": { "type": "array", "items": { "type": "string" } },
          "enabled": { "type": "boolean" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } } }
        }
      }
    },
    "/api/v1/accounts": {
      "get": {
        "tags": ["Accounts"],
        "summary": "List all accounts",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountListResponse" } } } }
        }
      },
      "post": {
        "tags": ["Accounts"],
        "summary": "Create a new account",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateAccountRequest" } } } },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateAccountResponse" } } } },
          "400": { "description": "Bad request" },
          "409": { "description": "Phone already exists" }
        }
      }
    },
    "/api/v1/accounts/{account_id}": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "get": {
        "tags": ["Accounts"],
        "summary": "Get account details",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountInfo" } } } },
          "404": { "description": "Not found" }
        }
      },
      "patch": {
        "tags": ["Accounts"],
        "summary": "Update account",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateAccountRequest" } } } },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountInfo" } } } },
          "404": { "description": "Not found" }
        }
      },
      "delete": {
        "tags": ["Accounts"],
        "summary": "Delete an account",
        "parameters": [{ "name": "delete_data", "in": "query", "schema": { "type": "boolean", "default": false } }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeleteAccountResponse" } } } },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/proxy": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "get": {
        "tags": ["Proxy"],
        "summary": "Get proxy configuration",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProxyConfigResponse" } } } },
          "404": { "description": "No proxy configured or account not found" }
        }
      },
      "put": {
        "tags": ["Proxy"],
        "summary": "Set proxy configuration",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SetProxyRequest" } } } },
        "responses": {
          "200": { "description": "Proxy configured", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProxyConfigResponse" } } } },
          "400": { "description": "Validation error" },
          "404": { "description": "Account not found" }
        }
      },
      "delete": {
        "tags": ["Proxy"],
        "summary": "Remove proxy configuration",
        "responses": {
          "200": { "description": "Proxy removed" },
          "404": { "description": "Account not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/session": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "get": {
        "tags": ["Session"],
        "summary": "Get WhatsApp session status",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionStatus" } } } },
          "404": { "description": "Not found" }
        }
      },
      "delete": {
        "tags": ["Session"],
        "summary": "Logout / unlink WhatsApp session",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountActionResponse" } } } },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/session/qr": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "get": {
        "tags": ["Session"],
        "summary": "Get QR code for linking",
        "description": "Returns a 512x512 PNG image. Waits up to 60s for QR generation.",
        "responses": {
          "200": { "description": "QR code PNG", "content": { "image/png": { "schema": { "type": "string", "format": "binary" } } } },
          "404": { "description": "Not found" },
          "409": { "description": "Already logged in" },
          "504": { "description": "Timeout" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/session/pair": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "post": {
        "tags": ["Session"],
        "summary": "Link via phone number pairing code",
        "description": "Uses the phone number provided at account creation.",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PhoneLinkResponse" } } } },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/messages": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "get": {
        "tags": ["Messaging"],
        "summary": "List stored messages for a chat",
        "parameters": [
          { "name": "chat", "in": "query", "required": true, "schema": { "type": "string" }, "description": "Chat JID to list messages for" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 }, "description": "Max messages to return" },
          { "name": "before", "in": "query", "schema": { "type": "string", "format": "date-time" }, "description": "RFC3339 cursor for pagination" }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageListResponse" } } } },
          "400": { "description": "Missing chat parameter" },
          "404": { "description": "Account not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/messages/send": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "post": {
        "tags": ["Messaging"],
        "summary": "Send a message",
        "description": "Send text, file, or both. Recipient can be specified via query params (?phone= or ?jid=) or in the JSON body (chat or phone field). Query params take precedence. Use 'reply_to' to quote an existing message.",
        "parameters": [
          { "name": "phone", "in": "query", "schema": { "type": "string" }, "description": "Phone number (international, digits only)" },
          { "name": "jid", "in": "query", "schema": { "type": "string" }, "description": "WhatsApp JID (e.g. 919999999999@s.whatsapp.net)" },
          { "name": "text", "in": "query", "schema": { "type": "string" }, "description": "Message text (alternative to JSON body)" },
          { "name": "reply_to", "in": "query", "schema": { "type": "string" }, "description": "Message ID to reply to" }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": { "type": "string", "description": "Text message or caption" },
                  "file": { "type": "string", "format": "binary", "description": "File attachment" },
                  "reply_to": { "type": "string", "description": "Message ID to reply to" }
                }
              }
            },
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendMessageRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SendMessageResponse" } } } },
          "400": { "description": "Bad request" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/messages/{message_id}": {
      "parameters": [
        { "$ref": "#/components/parameters/AccountId" },
        { "name": "message_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "delete": {
        "tags": ["Messaging"],
        "summary": "Revoke (delete for everyone) a message",
        "parameters": [{ "name": "chat", "in": "query", "required": true, "schema": { "type": "string" }, "description": "Chat JID where the message was sent" }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RevokeMessageResponse" } } } },
          "400": { "description": "Bad request" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/messages/react": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "post": {
        "tags": ["Messaging"],
        "summary": "React to a message",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReactionRequest" } } } },
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/messages/read": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "post": {
        "tags": ["Messaging"],
        "summary": "Mark messages as read",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MarkReadRequest" } } } },
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "Bad request" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/chats": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "get": {
        "tags": ["Chats"],
        "summary": "List chats",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChatListResponse" } } } },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/contacts": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "get": {
        "tags": ["Contacts"],
        "summary": "List all contacts",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ContactListResponse" } } } },
          "404": { "description": "Not found" }
        }
      }
