{
  "openapi": "3.0.3",
  "info": {
    "title": "WaLink API",
    "description": "WhatsApp messaging API powered by whatsmeow",
    "version": "0.2.0",
    "license": { "name": "MIT" }
  },
  "servers": [{ "url": "http://localhost:3000", "description": "Local" }],
  "security": [{ "BearerAuth": [] }],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Enter: Bearer <your-secret-key>"
      }
    },
    "parameters": {
      "AccountId": { "name": "account_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "JID": { "name": "jid", "in": "path", "required": true, "schema": { "type": "string" }, "description": "WhatsApp JID (e.g. 919876543210@s.whatsapp.net)" }
    },
    "schemas": {
      "AccountInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "phone_number": { "type": "string", "nullable": true },
          "account_name": { "type": "string" },
          "authorized": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "AccountListResponse": {
        "type": "object",
        "properties": {
          "accounts": { "type": "array", "items": { "$ref": "#/components/schemas/AccountInfo" } },
          "total": { "type": "integer" }
        }
      },
      "CreateAccountRequest": {
        "type": "object",
        "required": ["phone_number"],
        "properties": {
          "phone_number": { "type": "string", "example": "+919876543210" },
          "account_name": { "type": "string", "example": "main" }
        }
      },
      "CreateAccountResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "phone_number": { "type": "string" },
          "account_name": { "type": "string" },
          "created_at": { "type": "string" }
        }
      },
      "UpdateAccountRequest": {
        "type": "object",
        "properties": {
          "account_name": { "type": "string" }
        }
      },
      "DeleteAccountResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "account_id": { "type": "string" },
          "data_deleted": { "type": "boolean" }
        }
      },
      "SessionStatus": {
        "type": "object",
        "properties": {
          "account_id": { "type": "string" },
          "phone_number": { "type": "string", "nullable": true },
          "authorized": { "type": "boolean" }
        }
      },
      "PhoneLinkResponse": {
        "type": "object",
        "properties": { "linking_code": { "type": "string" } }
      },
      "AccountActionResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "account_id": { "type": "string" }
        }
      },
      "SetProxyRequest": {
        "type": "object",
        "required": ["protocol", "host", "port"],
        "properties": {
          "protocol": { "type": "string", "enum": ["http", "https", "socks5"], "example": "socks5" },
          "host": { "type": "string", "example": "proxy.example.com" },
          "port": { "type": "integer", "example": 1080 },
          "username": { "type": "string" },
          "password": { "type": "string" },
          "enabled": { "type": "boolean", "default": true }
        }
      },
      "ProxyConfigResponse": {
        "type": "object",
        "properties": {
          "protocol": { "type": "string" },
          "host": { "type": "string" },
          "port": { "type": "integer" },
          "username": { "type": "string" },
          "enabled": { "type": "boolean" }
        }
      },
      "SendMessageRequest": {
        "type": "object",
        "required": ["chat"],
        "properties": {
          "chat": { "type": "string", "example": "919876543210@s.whatsapp.net" },
          "text": { "type": "string", "example": "Hello from WaLink!" }
        }
      },
      "SendMessageResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "message_id": { "type": "string" }
        }
      },
      "ReactionRequest": {
        "type": "object",
        "required": ["chat", "message_id", "emoji"],
        "properties": {
          "chat": { "type": "string" },
          "message_id": { "type": "string" },
          "emoji": { "type": "string", "example": "\ud83d\udc4d" }
        }
      },
      "ReplyMessageRequest": {
        "type": "object",
        "required": ["chat", "message_id", "text"],
        "properties": {
          "chat": { "type": "string" },
          "message_id": { "type": "string" },
          "text": { "type": "string" }
        }
      },
      "MarkReadRequest": {
        "type": "object",
        "required": ["chat", "message_ids"],
        "properties": {
          "chat": { "type": "string" },
          "message_ids": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ChatInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "is_group": { "type": "boolean" },
          "pinned": { "type": "boolean" },
          "muted": { "type": "boolean" },
          "archived": { "type": "boolean" }
        }
      },
      "ChatListResponse": {
        "type": "object",
        "properties": {
          "chats": { "type": "array", "items": { "$ref": "#/components/schemas/ChatInfo" } },
          "total": { "type": "integer" }
        }
      },
      "ContactInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "push_name": { "type": "string" },
          "full_name": { "type": "string" },
          "first_name": { "type": "string" },
          "business_name": { "type": "string" },
          "phone": { "type": "string", "nullable": true }
        }
      },
      "GroupParticipant": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "nullable": true },
          "is_admin": { "type": "boolean" }
        }
      },
      "GroupInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "nullable": true },
          "created_by": { "type": "string", "nullable": true },
          "participant_count": { "type": "integer" },
          "participants": { "type": "array", "items": { "$ref": "#/components/schemas/GroupParticipant" } },
          "is_announce": { "type": "boolean" },
          "is_locked": { "type": "boolean" },
          "invite_link": { "type": "string", "nullable": true }
        }
      },
      "GroupListResponse": {
        "type": "object",
        "properties": {
          "groups": { "type": "array", "items": { "$ref": "#/components/schemas/GroupInfo" } },
          "total": { "type": "integer" }
        }
      },
      "CreateGroupRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "maxLength": 25 },
          "participants": { "type": "array", "items": { "type": "string" } }
        }
      },
      "UpdateGroupRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "locked": { "type": "boolean" },
          "announce": { "type": "boolean" }
        }
      },
      "GroupParticipantsRequest": {
        "type": "object",
        "required": ["participants", "action"],
        "properties": {
          "participants": { "type": "array", "items": { "type": "string" } },
          "action": { "type": "string", "enum": ["add", "remove", "promote", "demote"] }
        }
      },
      "GroupInviteLinkResponse": {
        "type": "object",
        "properties": { "invite_link": { "type": "string" } }
      },
      "PresenceRequest": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": { "type": "string", "enum": ["composing", "paused", "available", "unavailable"] },
          "chat": { "type": "string", "description": "JID for chat-level typing. Omit for global presence." }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "phone_number": { "type": "string", "nullable": true },
          "about": { "type": "string", "nullable": true },
          "picture_url": { "type": "string", "nullable": true }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "about": { "type": "string" }
        }
      },
      "PrivacySettings": {
        "type": "object",
        "properties": {
          "group_add": { "type": "string" },
          "last_seen": { "type": "string" },
          "status": { "type": "string" },
          "profile": { "type": "string" },
          "read_receipts": { "type": "string" },
          "online": { "type": "string" },
          "call_add": { "type": "string" }
        }
      },
      "UpdatePrivacyRequest": {
        "type": "object",
        "properties": {
          "group_add": { "type": "string", "enum": ["all", "contacts", "contact_blacklist", "none"] },
          "last_seen": { "type": "string", "enum": ["all", "contacts", "contact_blacklist", "none"] },
          "status": { "type": "string", "enum": ["all", "contacts", "contact_blacklist", "none"] },
          "profile": { "type": "string", "enum": ["all", "contacts", "contact_blacklist", "none"] },
          "read_receipts": { "type": "string", "enum": ["all", "none"] },
          "online": { "type": "string", "enum": ["all", "match_last_seen"] },
          "call_add": { "type": "string", "enum": ["all", "known"] }
        }
      },
      "NewsletterInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "subscriber_count": { "type": "integer" },
          "role": { "type": "string", "nullable": true },
          "muted": { "type": "boolean" },
          "picture_url": { "type": "string", "nullable": true }
        }
      },
      "NewsletterListResponse": {
        "type": "object",
        "properties": {
          "newsletters": { "type": "array", "items": { "$ref": "#/components/schemas/NewsletterInfo" } },
          "total": { "type": "integer" }
        }
      },
      "CreateNewsletterRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": { "status": { "type": "string", "example": "ok" } }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } } }
        }
      }
    },
    "/api/v1/accounts": {
      "get": {
        "tags": ["Accounts"],
        "summary": "List all accounts",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountListResponse" } } } }
        }
      },
      "post": {
        "tags": ["Accounts"],
        "summary": "Create a new account",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateAccountRequest" } } } },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateAccountResponse" } } } },
          "400": { "description": "Bad request" },
          "409": { "description": "Phone already exists" }
        }
      }
    },
    "/api/v1/accounts/{account_id}": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "get": {
        "tags": ["Accounts"],
        "summary": "Get account details",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountInfo" } } } },
          "404": { "description": "Not found" }
        }
      },
      "patch": {
        "tags": ["Accounts"],
        "summary": "Update account",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateAccountRequest" } } } },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountInfo" } } } },
          "404": { "description": "Not found" }
        }
      },
      "delete": {
        "tags": ["Accounts"],
        "summary": "Delete an account",
        "parameters": [{ "name": "delete_data", "in": "query", "schema": { "type": "boolean", "default": false } }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeleteAccountResponse" } } } },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/proxy": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "get": {
        "tags": ["Proxy"],
        "summary": "Get proxy configuration",
        "operationId": "getProxy",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProxyConfigResponse" } } } },
          "404": { "description": "No proxy configured or account not found" }
        }
      },
      "put": {
        "tags": ["Proxy"],
        "summary": "Set proxy configuration",
        "operationId": "setProxy",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SetProxyRequest" } } } },
        "responses": {
          "200": { "description": "Proxy configured", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProxyConfigResponse" } } } },
          "400": { "description": "Validation error" },
          "404": { "description": "Account not found" }
        }
      },
      "delete": {
        "tags": ["Proxy"],
        "summary": "Remove proxy configuration",
        "operationId": "deleteProxy",
        "responses": {
          "200": { "description": "Proxy removed" },
          "404": { "description": "Account not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/session": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "get": {
        "tags": ["Session"],
        "summary": "Get WhatsApp session status",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionStatus" } } } },
          "404": { "description": "Not found" }
        }
      },
      "delete": {
        "tags": ["Session"],
        "summary": "Logout / unlink WhatsApp session",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountActionResponse" } } } },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/session/qr": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "get": {
        "tags": ["Session"],
        "summary": "Get QR code for linking",
        "description": "Returns a 512x512 PNG image. Waits up to 60s for QR generation.",
        "responses": {
          "200": { "description": "QR code PNG", "content": { "image/png": { "schema": { "type": "string", "format": "binary" } } } },
          "404": { "description": "Not found" },
          "409": { "description": "Already logged in" },
          "504": { "description": "Timeout" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/session/pair": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "post": {
        "tags": ["Session"],
        "summary": "Link via phone number pairing code",
        "description": "Uses the phone number provided at account creation.",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PhoneLinkResponse" } } } },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/messages": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "post": {
        "tags": ["Messaging"],
        "summary": "Send a message",
        "description": "Send text, file, or both. Provide at least one of 'text' or 'file'.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["chat"],
                "properties": {
                  "chat": { "type": "string", "description": "Recipient JID (e.g. 919876543210@s.whatsapp.net)" },
                  "text": { "type": "string", "description": "Text message or caption for the file" },
                  "file": { "type": "string", "format": "binary", "description": "File attachment (image, document, etc.)" }
                }
              },
              "encoding": {
                "file": { "contentType": "application/octet-stream" }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SendMessageResponse" } } } },
          "400": { "description": "Bad request" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/messages/react": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "post": {
        "tags": ["Messaging"],
        "summary": "React to a message",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReactionRequest" } } } },
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/messages/reply": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "post": {
        "tags": ["Messaging"],
        "summary": "Reply to a message",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReplyMessageRequest" } } } },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SendMessageResponse" } } } },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/messages/read": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "post": {
        "tags": ["Messaging"],
        "summary": "Mark messages as read",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MarkReadRequest" } } } },
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "Bad request" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/chats": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "get": {
        "tags": ["Chats"],
        "summary": "List chats",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChatListResponse" } } } },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/contacts/{jid}": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }, { "$ref": "#/components/parameters/JID" }],
      "get": {
        "tags": ["Contacts"],
        "summary": "Get contact info",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ContactInfo" } } } },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/groups": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "get": {
        "tags": ["Groups"],
        "summary": "List joined groups",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupListResponse" } } } },
          "404": { "description": "Not found" }
        }
      },
      "post": {
        "tags": ["Groups"],
        "summary": "Create a group",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateGroupRequest" } } } },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupInfo" } } } },
          "400": { "description": "Bad request" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/groups/{jid}": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }, { "$ref": "#/components/parameters/JID" }],
      "get": {
        "tags": ["Groups"],
        "summary": "Get group info",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupInfo" } } } },
          "404": { "description": "Not found" }
        }
      },
      "patch": {
        "tags": ["Groups"],
        "summary": "Update group settings",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateGroupRequest" } } } },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupInfo" } } } },
          "404": { "description": "Not found" }
        }
      },
      "delete": {
        "tags": ["Groups"],
        "summary": "Leave group",
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/groups/{jid}/invite": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }, { "$ref": "#/components/parameters/JID" }],
      "get": {
        "tags": ["Groups"],
        "summary": "Get group invite link",
        "parameters": [{ "name": "reset", "in": "query", "schema": { "type": "boolean", "default": false } }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupInviteLinkResponse" } } } },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/groups/{jid}/participants": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }, { "$ref": "#/components/parameters/JID" }],
      "post": {
        "tags": ["Groups"],
        "summary": "Add/remove/promote/demote participants",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupParticipantsRequest" } } } },
        "responses": {
          "200": { "description": "OK" },
          "400": { "description": "Bad request" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/api/v1/accounts/{account_id}/presence": {
      "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
      "post": {
        "tags": ["Presence"],
        "summary": "Set presence or typing indicator",
        "description": "With 'chat': sends typing (composing/paused). Without: sets global presence (available/unavailable).",
